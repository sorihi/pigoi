package {{ .Name }}

import (
	"context"
	"errors"
	"fmt"
	"log"

	amqp "github.com/rabbitmq/amqp091-go"
	"go.uber.org/fx"

	"{{ .Module }}/pkg/rabbitmq"
)

const queueName = {{ printf "%q" .Name }}

func RegisterBroker(lifecycle fx.Lifecycle, shutdowner fx.Shutdowner, connection *rabbitmq.Connection, consumer *Consumer) {
	var cancel context.CancelFunc
	done := make(chan struct{})

	lifecycle.Append(fx.Hook{
		OnStart: func(context.Context) error {
			channel, err := connection.Channel()
			if err != nil {
				return fmt.Errorf("open RabbitMQ channel for %q: %w", queueName, err)
			}

			// The consumer must outlive the Fx startup context.
			ctx, stop := context.WithCancel(context.Background())
			deliveries, err := subscribe(channel)
			if err != nil {
				stop()
				_ = channel.Close()
				return err
			}
			cancel = stop
			log.Printf("RabbitMQ consumer subscribed to queue %q", queueName)
			go func() {
				defer close(done)
				defer channel.Close()
				if err := consume(ctx, consumer, deliveries); err != nil {
					log.Printf("RabbitMQ consumer for queue %q stopped: %v", queueName, err)
					_ = shutdowner.Shutdown(fx.ExitCode(1))
				}
			}()
			return nil
		},
		OnStop: func(ctx context.Context) error {
			cancel()
			select {
			case <-done:
				return nil
			case <-ctx.Done():
				return ctx.Err()
			}
		},
	})
}

func subscribe(channel *amqp.Channel) (<-chan amqp.Delivery, error) {
	if _, err := channel.QueueDeclare(queueName, true, false, false, false, nil); err != nil {
		return nil, fmt.Errorf("declare RabbitMQ queue %q: %w", queueName, err)
	}
	if err := channel.Qos(1, 0, false); err != nil {
		return nil, fmt.Errorf("set RabbitMQ prefetch for %q: %w", queueName, err)
	}
	deliveries, err := channel.Consume(queueName, "", false, false, false, false, nil)
	if err != nil {
		return nil, fmt.Errorf("subscribe to RabbitMQ queue %q: %w", queueName, err)
	}
	return deliveries, nil
}

func consume(ctx context.Context, consumer *Consumer, deliveries <-chan amqp.Delivery) error {
	for {
		select {
		case <-ctx.Done():
			return nil
		case delivery, ok := <-deliveries:
			if ctx.Err() != nil {
				return nil
			}
			if !ok {
				return errors.New("RabbitMQ delivery stream closed")
			}
			if err := consumer.Consume(ctx, delivery); err != nil && ctx.Err() == nil {
				return err
			}
		}
	}
}
